# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# S01 owns authentication configuration. Generate a private random secret of at least
# 32 UTF-8 bytes through the team's approved private process. Never commit a real secret.
JWT_SECRET="replace-with-a-private-random-secret-at-least-32-utf8-bytes"
