generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT       @map("Student")
  WARDEN        @map("Warden")
  KITCHEN_STAFF @map("Kitchen Staff")
  MANAGER       @map("Manager")
}

enum ComplaintCategory {
  WATER       @map("Water")
  HYGIENE     @map("Hygiene")
  PESTS       @map("Pests")
  ELECTRICITY @map("Electricity")
  FACILITIES  @map("Facilities")
}

enum ComplaintStatus {
  PENDING      @map("Pending")
  IN_PROGRESS  @map("In Progress")
  RESOLVED     @map("Resolved")
  ESCALATED    @map("Escalated")
}

enum ResponsibilityStatus {
  PENDING_ACCEPTANCE @map("Pending Acceptance")
  ACTIVE             @map("Active")
  ASSISTANCE_REQUESTED @map("Assistance Requested")
  COMPLETED          @map("Completed")
  CANCELLED           @map("Cancelled")
}

enum ResponsibilityAssignmentStatus {
  PENDING   @map("Pending")
  ACCEPTED  @map("Accepted")
  REJECTED  @map("Rejected")
  COMPLETED @map("Completed")
  WITHDRAWN @map("Withdrawn")
}

enum AssistanceRequestStatus {
  ACTIVE @map("Active")
  CLOSED @map("Closed")
}

model User {
  mealPortionLogs MealPortionLog[]
  mealPortionAudits MealPortionAudit[]
  mealPortionDiscrepancies MealPortionDiscrepancy[]
  mealReservations MealReservation[]
  mealCollectionNotices MealCollectionNotice[]
  receivedMealApprovals MealApproval[] @relation("MealApprovalStudent")
  issuedMealApprovals MealApproval[] @relation("MealApprovalWarden")
  weeklyMenus WeeklyMenu[]
  id            String         @id @default(uuid()) @db.Uuid
  fullName      String         @map("full_name")
  email         String         @unique
  passwordHash  String         @map("password_hash")
  role          UserRole
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  notifications Notification[]
  personalSchedules  PersonalSchedule[]
  responsibilityAssignments ResponsibilityAssignment[]
  responsibilitiesCreated Responsibility[] @relation("ResponsibilityCreator")
  assistanceRequests AssistanceRequest[]
  complaints Complaint[]
  complaintStatusHistoryChanges ComplaintStatusHistory[]
  assignedComplaints Complaint[] @relation("ComplaintManager")
  roomMemberships RoomResident[] @relation("RoomResidentStudent")
  roomAssignmentActions RoomResident[] @relation("RoomResidentActor")
  roomTransferActions RoomResident[] @relation("RoomResidentEndActor")
  roomVerificationActions RoomResident[] @relation("RoomResidentVerifier")
  primaryWardenOf House[] @relation("PrimaryWarden")
  houseAssignments HouseWarden[]

  @@map("users")
}

enum WeeklyMenuStatus {
  DRAFT     @map("Draft")
  PUBLISHED @map("Published")
  ARCHIVED  @map("Archived")
}

enum MealType {
  BREAKFAST @map("Breakfast")
  LUNCH     @map("Lunch")
  DINNER    @map("Dinner")
}

model WeeklyMenu {
  id            String           @id @default(uuid()) @db.Uuid
  weekStartDate DateTime         @unique @map("week_start_date") @db.Date
  status        WeeklyMenuStatus @default(DRAFT)
  createdBy     String           @map("created_by") @db.Uuid
  creator       User             @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  items         MenuItem[]

  @@map("weekly_menus")
}

model MenuItem {
  portionLogs MealPortionLog[]
  allocationSnapshots MealAllocationSnapshot[]
  id           String     @id @default(uuid()) @db.Uuid
  weeklyMenuId String     @map("weekly_menu_id") @db.Uuid
  weeklyMenu   WeeklyMenu @relation(fields: [weeklyMenuId], references: [id], onDelete: Restrict)
  mealDate     DateTime   @map("meal_date") @db.Date
  mealType     MealType   @map("meal_type")
  itemName     String     @map("item_name")
  description  String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([weeklyMenuId, mealDate, mealType])
  @@map("menu_items")
}

model PersonalSchedule {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  title          String
  description    String?
  startAt        DateTime @map("start_at")
  endAt          DateTime @map("end_at")
  recurrenceRule String?  @map("recurrence_rule")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId, startAt])
  @@index([startAt])
  @@map("personal_schedules")
}

model Notification {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  type             String
  title            String
  message          String
  relatedModule    String    @map("related_module")
  relatedEntityId  String    @map("related_entity_id")
  isRead           Boolean   @default(false) @map("is_read")
  createdAt        DateTime  @default(now()) @map("created_at")
  readAt           DateTime? @map("read_at")
  deduplicationKey String    @unique @map("deduplication_key")
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("notifications")
}

model Responsibility {
  id                 String               @id @default(uuid()) @db.Uuid
  createdByUserId    String               @map("created_by_user_id") @db.Uuid
  title              String
  description        String
  dueAt              DateTime             @map("due_at") @db.Timestamptz(3)
  acceptanceDeadline DateTime?             @map("acceptance_deadline") @db.Timestamptz(3)
  roomId             String               @map("room_id") @db.Uuid
  houseId            String               @map("house_id") @db.Uuid
  status             ResponsibilityStatus  @default(PENDING_ACCEPTANCE)
  revision           Int                  @default(0)
  completedAt        DateTime?             @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          User                 @relation("ResponsibilityCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignments        ResponsibilityAssignment[]
  assistanceRequests AssistanceRequest[]
  requests           ResponsibilityReview[]
  distributedAt      DateTime?            @map("distributed_at") @db.Timestamptz(3)
  needsRedistribution Boolean             @default(false) @map("needs_redistribution")
  room               Room                 @relation(fields: [roomId, houseId], references: [id, houseId], onDelete: Restrict)

  @@index([roomId, status, dueAt])
  @@index([houseId, status, createdAt])
  @@map("responsibilities")
}

model ResponsibilityAssignment {
  id                String                            @id @default(uuid()) @db.Uuid
  responsibilityId  String                            @map("responsibility_id") @db.Uuid
  studentUserId     String                            @map("student_user_id") @db.Uuid
  status            ResponsibilityAssignmentStatus   @default(PENDING)
  acceptedAt        DateTime?                         @map("accepted_at") @db.Timestamptz(3)
  rejectedAt        DateTime?                         @map("rejected_at") @db.Timestamptz(3)
  withdrawnAt       DateTime?                         @map("withdrawn_at") @db.Timestamptz(3)
  completedAt       DateTime?                         @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime                          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(3)
  reminderVersion   Int                               @default(0) @map("reminder_version")
  reminderEligibleAt DateTime?                        @map("reminder_eligible_at") @db.Timestamptz(3)
  lastReminderAt    DateTime?                         @map("last_reminder_at") @db.Timestamptz(3)
  incompleteConfirmedAt DateTime?                    @map("incomplete_confirmed_at") @db.Timestamptz(3)
  incompleteConfirmationSource String?               @map("incomplete_confirmation_source")
  responsibility   Responsibility                   @relation(fields: [responsibilityId], references: [id], onDelete: Restrict)
  student           User                              @relation(fields: [studentUserId], references: [id], onDelete: Restrict)

  // PostgreSQL migration adds a partial unique index for non-Withdrawn assignment rows.
  @@index([responsibilityId, studentUserId])
  @@index([studentUserId, status, createdAt])
  @@map("responsibility_assignments")
}

model AssistanceRequest {
  id                String                 @id @default(uuid()) @db.Uuid
  responsibilityId  String                 @map("responsibility_id") @db.Uuid
  requestedByUserId String                 @map("requested_by_user_id") @db.Uuid
  status            AssistanceRequestStatus @default(ACTIVE)
  deduplicationKey  String                 @unique @map("deduplication_key")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  closedAt          DateTime?              @map("closed_at") @db.Timestamptz(3)
  responsibility   Responsibility        @relation(fields: [responsibilityId], references: [id], onDelete: Restrict)
  requestedBy       User                   @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([responsibilityId, status, createdAt])
  @@map("assistance_requests")
}

model ResponsibilityReview {
  id               String         @id @default(uuid()) @db.Uuid
  responsibilityId String         @map("responsibility_id") @db.Uuid
  requestedBy      String         @map("requested_by") @db.Uuid
  kind             String
  note             String
  requestedAt      DateTime       @default(now()) @map("requested_at") @db.Timestamptz(3)
  reviewedBy       String?        @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  approved         Boolean?
  responsibility   Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Restrict)

  @@index([responsibilityId, reviewedAt])
  @@map("responsibility_reviews")
}

model Complaint {
  id           String            @id @default(uuid()) @db.Uuid
  submittedBy  String            @map("submitted_by") @db.Uuid
  category     ComplaintCategory
  roomNumber   String            @map("room_number")
  description  String
  urgencyFlag  Boolean           @map("urgency_flag")
  status       ComplaintStatus   @default(PENDING)
  submittedAt  DateTime          @map("submitted_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  submitter    User              @relation(fields: [submittedBy], references: [id], onDelete: Restrict)
  statusHistory ComplaintStatusHistory[]
  submittedHouseId String?       @map("submitted_house_id") @db.Uuid
  submittedHouse   House?        @relation(fields: [submittedHouseId], references: [id], onDelete: Restrict)
  originalComplaintId String?    @map("original_complaint_id") @db.Uuid
  originalComplaint Complaint?   @relation("ComplaintFollowUps", fields: [originalComplaintId], references: [id], onDelete: Restrict)
  followUps Complaint[]           @relation("ComplaintFollowUps")
  disagreementReason String?     @map("disagreement_reason")
  assignedManagerId String?      @map("assigned_manager_id") @db.Uuid
  assignedManager User?          @relation("ComplaintManager", fields: [assignedManagerId], references: [id], onDelete: Restrict)
  manualEscalationEligibleAt DateTime? @map("manual_escalation_eligible_at")
  manualEscalationRequestedAt DateTime? @map("manual_escalation_requested_at")
  autoEscalatedAt DateTime? @map("auto_escalated_at")

  @@index([submittedBy, submittedAt])
  @@index([submittedHouseId, submittedAt])
  @@index([status, submittedAt])
  @@index([assignedManagerId, submittedAt])
  @@index([originalComplaintId])
  @@map("complaints")
}

model ComplaintStatusHistory {
  id           String           @id @default(uuid()) @db.Uuid
  complaintId  String           @map("complaint_id") @db.Uuid
  oldStatus    ComplaintStatus? @map("old_status")
  newStatus    ComplaintStatus  @map("new_status")
  changedBy    String?          @map("changed_by") @db.Uuid
  reason       String?
  changedAt    DateTime         @map("changed_at")
  complaint    Complaint        @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  changedByUser User?           @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([complaintId, changedAt])
  @@map("complaint_status_history")
}

enum WorkerJobStatus {
  PENDING    @map("Pending")
  PROCESSING @map("Processing")
  SUCCEEDED  @map("Succeeded")
  FAILED     @map("Failed")
}

model WorkerJobRun {
  id             String          @id @default(uuid()) @db.Uuid
  jobType        String          @map("job_type")
  targetType     String          @map("target_type")
  targetId       String          @map("target_id") @db.Uuid
  idempotencyKey String          @unique @map("idempotency_key")
  scheduledFor   DateTime        @map("scheduled_for")
  status         WorkerJobStatus @default(PENDING)
  attemptCount   Int             @default(0) @map("attempt_count")
  maxAttempts    Int             @default(4) @map("max_attempts")
  nextAttemptAt  DateTime?       @map("next_attempt_at")
  lockedAt       DateTime?       @map("locked_at")
  lockedBy       String?         @map("locked_by")
  lastError      String?         @map("last_error")
  completedAt    DateTime?       @map("completed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([jobType, status, nextAttemptAt])
  @@index([jobType, status, lockedAt])
  @@map("worker_job_runs")
}

model House {
  mealReservations MealReservation[]
  mealCollectionNotices MealCollectionNotice[]
  id              String  @id @default(uuid()) @db.Uuid
  name            String  @unique
  primaryWardenId String? @map("primary_warden_id") @db.Uuid
  primaryWarden   User?   @relation("PrimaryWarden", fields: [primaryWardenId], references: [id], onDelete: Restrict)
  rooms           Room[]
  wardens         HouseWarden[]
  complaints      Complaint[]

  @@index([primaryWardenId])
  @@map("houses")
}

enum MealReservationStatus {
  RESERVED @map("Reserved")
  CANCELLED @map("Cancelled")
  FULFILLED @map("Fulfilled")
}

model MealApproval {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  approvedBy String   @map("approved_by") @db.Uuid
  mealDate   DateTime @map("meal_date") @db.Date
  mealType   MealType @map("meal_type")
  approvedAt DateTime @default(now()) @map("approved_at")
  student    User     @relation("MealApprovalStudent", fields: [studentId], references: [id], onDelete: Restrict)
  warden     User     @relation("MealApprovalWarden", fields: [approvedBy], references: [id], onDelete: Restrict)

  @@unique([studentId, mealDate, mealType])
  @@map("meal_approvals")
}

model MealCollectionWindow {
  mealType MealType @id @map("meal_type")
  opensAt  String   @map("opens_at")
  closesAt String   @map("closes_at")

  @@map("meal_collection_windows")
}

model MealPortionLog {
  id               String   @id @default(uuid()) @db.Uuid
  mealDate         DateTime @map("meal_date") @db.Date
  mealType         MealType @map("meal_type")
  menuItemId       String?  @map("menu_item_id") @db.Uuid
  itemNameSnapshot String   @map("item_name_snapshot")
  portionCount     Int      @map("portion_count")
  loggedBy         String   @map("logged_by") @db.Uuid
  loggedAt         DateTime @default(now()) @map("logged_at")
  requestId        String   @map("request_id") @db.Uuid
  menuItem         MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  logger           User     @relation(fields: [loggedBy], references: [id], onDelete: Restrict)
  audit            MealPortionAudit?
  discrepancy      MealPortionDiscrepancy?

  @@unique([loggedBy, requestId])
  @@index([mealDate, loggedAt])
  @@map("meal_portion_logs")
}

model MealPortionAudit {
  portionLogId     String   @id @map("portion_log_id") @db.Uuid
  recordedBy       String   @map("recorded_by") @db.Uuid
  expectedPortions Int      @map("expected_portions")
  observedPortions Int      @map("observed_portions")
  description      String?
  recordedAt       DateTime @default(now()) @map("recorded_at")
  log              MealPortionLog @relation(fields: [portionLogId], references: [id], onDelete: Restrict)
  auditor          User @relation(fields: [recordedBy], references: [id], onDelete: Restrict)

  @@map("meal_portion_audits")
}

model MealPortionDiscrepancy {
  id               String   @id @default(uuid()) @db.Uuid
  portionLogId     String   @unique @map("portion_log_id") @db.Uuid
  recordedBy       String   @map("recorded_by") @db.Uuid
  expectedPortions Int      @map("expected_portions")
  observedPortions Int      @map("observed_portions")
  description      String?
  recordedAt       DateTime @map("recorded_at")
  log              MealPortionLog @relation(fields: [portionLogId], references: [id], onDelete: Restrict)
  auditor          User @relation(fields: [recordedBy], references: [id], onDelete: Restrict)

  @@map("meal_portion_discrepancies")
}

model MealReservation {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @map("user_id") @db.Uuid
  submittedHouseId String?               @map("submitted_house_id") @db.Uuid
  mealDate         DateTime              @map("meal_date") @db.Date
  mealType         MealType              @map("meal_type")
  status           MealReservationStatus @default(RESERVED)
  reservedAt       DateTime              @default(now()) @map("reserved_at")
  student          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  house            House?                @relation(fields: [submittedHouseId], references: [id], onDelete: Restrict)
  snapshots        MealAllocationSnapshot[]
  notices          MealCollectionNotice[]

  @@unique([userId, mealDate, mealType])
  @@index([submittedHouseId, reservedAt])
  @@map("meal_reservations")
}

model MealAllocationSnapshot {
  id                String   @id @default(uuid()) @db.Uuid
  reservationId     String   @map("reservation_id") @db.Uuid
  menuItemId        String?  @map("menu_item_id") @db.Uuid
  itemNameSnapshot  String   @map("item_name_snapshot")
  mealDateSnapshot  DateTime @map("meal_date_snapshot") @db.Date
  mealTypeSnapshot  MealType @map("meal_type_snapshot")
  portionCount      Int      @map("portion_count")
  snapshotCreatedAt DateTime @default(now()) @map("snapshot_created_at")
  reservation       MealReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  menuItem          MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@map("meal_allocation_snapshots")
}

model MealCollectionNotice {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  submittedHouseId String?  @map("submitted_house_id") @db.Uuid
  reservationId    String?  @map("reservation_id") @db.Uuid
  requestId        String   @map("request_id") @db.Uuid
  mealDate         DateTime @map("meal_date") @db.Date
  mealType         MealType @map("meal_type")
  explanation      String
  submittedAt      DateTime @default(now()) @map("submitted_at")
  student          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  house            House?   @relation(fields: [submittedHouseId], references: [id], onDelete: Restrict)
  reservation      MealReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([userId, requestId])
  @@index([submittedHouseId, submittedAt])
  @@map("meal_collection_notices")
}

model HouseWarden {
  houseId String @map("house_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid
  house   House  @relation(fields: [houseId], references: [id], onDelete: Restrict)
  warden  User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([houseId, userId])
  @@index([userId])
  @@map("house_wardens")
}

model Room {
  id         String   @id @default(uuid()) @db.Uuid
  houseId    String   @map("house_id") @db.Uuid
  roomNumber String   @unique @map("room_number")
  block      String?
  floor      String?
  capacity   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  house      House    @relation(fields: [houseId], references: [id], onDelete: Restrict)
  residents  RoomResident[]
  responsibilities Responsibility[]

  @@unique([id, houseId])
  @@index([houseId])
  @@map("rooms")
}

model RoomResident {
  id           String    @id @default(uuid()) @db.Uuid
  roomId       String    @map("room_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  assignedAt   DateTime  @map("assigned_at")
  assignedBy  String    @map("assigned_by") @db.Uuid
  endedAt      DateTime? @map("ended_at")
  endedBy      String?   @map("ended_by") @db.Uuid
  verifiedAt   DateTime? @map("verified_at")
  verifiedBy   String?   @map("verified_by") @db.Uuid
  previousId   String?   @unique @map("previous_id") @db.Uuid
  changeType   String    @map("change_type")
  room         Room      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  student      User      @relation("RoomResidentStudent", fields: [userId], references: [id], onDelete: Restrict)
  actor        User      @relation("RoomResidentActor", fields: [assignedBy], references: [id], onDelete: Restrict)
  endActor     User?     @relation("RoomResidentEndActor", fields: [endedBy], references: [id], onDelete: Restrict)
  verifier     User?     @relation("RoomResidentVerifier", fields: [verifiedBy], references: [id], onDelete: Restrict)
  previous     RoomResident? @relation("RoomResidentTransfer", fields: [previousId], references: [id], onDelete: Restrict)
  next         RoomResident? @relation("RoomResidentTransfer")

  @@index([roomId, endedAt])
  @@index([userId])
  @@map("room_residents")
}
